# =============================================================================
# AI GrowthDesk — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Application ---
APP_NAME=AI GrowthDesk
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-secure-random-string
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=change-me-to-a-fernet-key

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/growthdesk

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- S3-Compatible Storage (Optional) ---
S3_ENDPOINT=
S3_BUCKET=growthdesk
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Frontend ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Razorpay (Optional — for subscription billing) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

